      "chapter": "Chapter 1 \u2014 The crossing",
      "text": "\"The bridge will hold,\"",
      "speaker": "Sam",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 1 \u2014 The crossing",
      "text": "\"You said that about the last bridge,\"",
      "speaker": "Mira",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 1 \u2014 The crossing",
      "text": "\"I was younger then,\"",
      "speaker": "Sam",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 1 \u2014 The crossing",
      "text": "\"It was yesterday,\"",
      "speaker": "Mira",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 1 \u2014 The crossing",
      "text": "\"Did you hear that?\"",
      "speaker": null,
      "review": 1,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 2 \u2014 The watch",
      "text": "\"Hold this steady,\"",
      "speaker": "Sam",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 2 \u2014 The watch",
      "text": "\"I have it,\"",
      "speaker": "Sam",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 2 \u2014 The watch",
      "text": "\"This is going to work,\"",
      "speaker": "Mira",
      "review": 0,
      "kind": "dialogue"
    },
    {
      "chapter": "Chapter 72 \u2014 Home again",
      "text": "\"I told you I would come back,\"",
      "speaker": "Mira",
      "review": 0,
      "kind": "dialogue"
    },
    {
